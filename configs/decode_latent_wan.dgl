# version: 0.0.0
# localVid Separate-Process Wan 2.1 VAE Decoder
# Usage:
#   SD_VIDEO_LATENT_LOAD=path/to/latent.bin SD_CONV_DIRECT_TOL=0.005 \
#     build/sdcpp-vulkan/bin/sd-cli.exe -M dgl --script configs/decode_latent_wan.dgl

var {
    vae_path = "models/vae/wan_2.1_vae.safetensors"
    output_path = "benchmarks/runs/p3_vae/decoded.avi"
    fps = 16
}

fn main() {
    vae = load_vae(vae_path, family = "wan2", params_backend = "cpu")
    dummy_latent = tensor::zeros([8, 8, 1, 16, 1])
    output_frames = vae_decode(vae, dummy_latent)
    video::save(output_path, {frames = output_frames, fps_num = fps, fps_den = 1}, audio = {})
    return {video = {frames = output_frames, fps_num = fps, fps_den = 1}}
}
