+static size_t cut_cache_host_threshold_bytes() {
+    static const size_t bytes = [] {
+        const char* e = std::getenv("SD_CUT_CACHE_HOST_MB");
+        if (e == nullptr || e[0] == '\0') {
+            return size_t(0);
+        }
+        const long long mb = std::atoll(e);
+        return mb > 0 ? static_cast<size_t>(mb) * 1024ULL * 1024ULL : size_t(0);
+    }();
+    return bytes;
+}
+
+static ggml_backend_t cut_cache_host_backend() {
+    static ggml_backend_t host = ggml_backend_cpu_init();
+    return host;
+}
 
