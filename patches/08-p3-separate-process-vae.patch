+    static void save_video_latent_file(const char* path, const sd::Tensor<float>& t) {
+        std::ofstream out(path, std::ios::binary);
+        if (!out) {
+            throw std::runtime_error(std::string("SD_VIDEO_LATENT_SAVE: failed to open ") + path);
+        }
+        const char magic[4] = {'L', 'V', 'L', 'T'};
+        const auto& shape   = t.shape();
+        const uint32_t ndim = static_cast<uint32_t>(shape.size());
+        out.write(magic, 4);
+        out.write(reinterpret_cast<const char*>(&ndim), sizeof(ndim));
+        for (int64_t d : shape) {
+            out.write(reinterpret_cast<const char*>(&d), sizeof(d));
+        }
+        const size_t nbytes = t.numel() * sizeof(float);
+        out.write(reinterpret_cast<const char*>(t.data()), static_cast<std::streamsize>(nbytes));
+        if (!out) {
+            throw std::runtime_error(std::string("SD_VIDEO_LATENT_SAVE: write failed for ") + path);
+        }
+        LOG_INFO("SD_VIDEO_LATENT_SAVE: saved %zu floats (%.2f MB) to '%s'",
+                 t.numel(), nbytes / (1024.0 * 1024.0), path);
+    }
+
+    static sd::Tensor<float> load_video_latent_file(const char* path) {
+        std::ifstream in(path, std::ios::binary);
+        if (!in) {
+            throw std::runtime_error(std::string("SD_VIDEO_LATENT_LOAD: failed to open ") + path);
+        }
+        char magic[4] = {};
+        uint32_t ndim = 0;
+        in.read(magic, 4);
+        in.read(reinterpret_cast<char*>(&ndim), sizeof(ndim));
+        if (!in || std::memcmp(magic, "LVLT", 4) != 0 || ndim == 0 || ndim > 8) {
+            throw std::runtime_error(std::string("SD_VIDEO_LATENT_LOAD: invalid header in ") + path);
+        }
+        std::vector<int64_t> shape(ndim);
+        for (uint32_t i = 0; i < ndim; ++i) {
+            in.read(reinterpret_cast<char*>(&shape[i]), sizeof(int64_t));
+        }
+        sd::Tensor<float> t(shape);
+        const size_t nbytes = t.numel() * sizeof(float);
+        in.read(reinterpret_cast<char*>(t.data()), static_cast<std::streamsize>(nbytes));
+        if (!in) {
+            throw std::runtime_error(std::string("SD_VIDEO_LATENT_LOAD: truncated data in ") + path);
+        }
+        LOG_INFO("SD_VIDEO_LATENT_LOAD: loaded %zu floats (%.2f MB) from '%s'",
+                 t.numel(), nbytes / (1024.0 * 1024.0), path);
+        return t;
+    }
